rules_version = '2';

// =========================================================
// 무역의 발견 + 무역 탐험대 훈련소 — Firestore 보안 규칙 (두 앱이 한 프로젝트를 함께 씀)
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 그대로 붙여 넣고 [게시]하세요.
//  - /rooms/...          본 수업 「무역의 발견」 (social-class 저장소의 규칙과 같은 내용)
//  - /practiceRooms/...  연습 앱 「무역 탐험대 훈련소」
//
// 원칙
//  - 교사: 구글 계정으로 로그인해 방을 만든 사람(ownerUid)만 단계 변경·잠금·취소·초기화 가능
//  - 학생: 익명 로그인. 처음 고른 나라(seat) 하나만 조작 가능
//  - 생산·거래는 서버에서 규칙대로인지 다시 검사 (생산량, 남은 기회, 재고, 수업 단계, 잠금)
//  - 입장 코드는 방을 찾는 데만 쓰이고, 권한을 주지 않음
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function rp(code) { return /databases/$(database)/documents/rooms/$(code); }
    function cp(code, cid) { return /databases/$(database)/documents/rooms/$(code)/countries/$(cid); }
    function tp(code, tid) { return /databases/$(database)/documents/rooms/$(code)/trades/$(tid); }
    function sp(code, cid) { return /databases/$(database)/documents/rooms/$(code)/seats/$(cid); }
    function mp(code, uid) { return /databases/$(database)/documents/rooms/$(code)/members/$(uid); }
    function room(code) { return get(rp(code)).data; }
    function isTeacher(code) { return signedIn() && room(code).ownerUid == request.auth.uid; }
    function holds(code, cid) { return signedIn() && exists(sp(code, cid)) && get(sp(code, cid)).data.uid == request.auth.uid; }
    function roundOf(r) { return r.stage <= 3 ? 1 : 2; }
    function canProduce(r) { return r.locks.production == false && (r.stage == 2 || r.stage == 5 || r.stage == 6); }
    function canTrade(r) { return r.stage == 6 && r.locks.trade == false; }
    // 거래량은 방에 저장된 고정 단위(units)와 정확히 같아야 함
    function unitOk(r, o) { return o.qty is int && o.qty == r.units[o.item]; }

    // ---------- 생산 ----------
    function produceOk(code, cid, item) {
      let r = room(code);
      let o = resource.data;
      let n = request.resource.data;
      let amt = r.outputs[cid][item];
      let k = o.log.size();
      return canProduce(r)
        && o.chances > 0 && n.chances == o.chances - 1
        && n.inv.diff(o.inv).affectedKeys().hasOnly([item])
        && n.inv[item] == o.inv[item] + amt
        && n.log.size() == k + 1
        && n.log[0:k] == o.log
        && n.log[k].item == item && n.log[k].amount == amt && n.log[k].round == roundOf(r)
        && n.diff(o).affectedKeys().hasOnly(['inv', 'chances', 'log', 'op']);
    }
    function undoOk(code, cid) {
      let r = room(code);
      let o = resource.data;
      let n = request.resource.data;
      let k = o.log.size() - 1;
      let last = o.log[k];
      return r.allowUndo == true && canProduce(r)
        && last.round == roundOf(r)
        && n.log == o.log[0:k]
        && n.chances == o.chances + 1
        && n.inv.diff(o.inv).affectedKeys().hasOnly([last.item])
        && n.inv[last.item] == o.inv[last.item] - last.amount
        && n.inv[last.item] >= 0
        && n.diff(o).affectedKeys().hasOnly(['inv', 'chances', 'log', 'op']);
    }
    function validProduce(code, cid) {
      return holds(code, cid) && request.resource.data.op.kind == 'produce'
        && produceOk(code, cid, request.resource.data.op.item);
    }
    function validUndo(code, cid) {
      return holds(code, cid) && request.resource.data.op.kind == 'undo'
        && resource.data.log.size() > 0 && undoOk(code, cid);
    }

    // ---------- 거래로 창고가 바뀌는 쪽 ----------
    function tradeSideOk(code, cid, tid) {
      let before = get(tp(code, tid)).data;
      let after = getAfter(tp(code, tid)).data;
      let o = resource.data;
      let n = request.resource.data;
      let gi = before.give.item;
      let gq = before.give.qty;
      let ti = before.get.item;
      let tq = before.get.qty;
      return holds(code, before.to) && canTrade(room(code))
        && before.status == 'pending' && after.status == 'done'
        && (cid == before.from || cid == before.to)
        && n.inv.diff(o.inv).affectedKeys().hasOnly([gi, ti])
        && (cid == before.from
              ? (n.inv[gi] == o.inv[gi] - gq && n.inv[ti] == o.inv[ti] + tq)
              : (n.inv[gi] == o.inv[gi] + gq && n.inv[ti] == o.inv[ti] - tq))
        && n.inv[gi] >= 0 && n.inv[ti] >= 0
        && n.diff(o).affectedKeys().hasOnly(['inv', 'op']);
    }
    function validTradeSide(code, cid) {
      return request.resource.data.op.kind == 'trade'
        && tradeSideOk(code, cid, request.resource.data.op.tid);
    }

    // ---------- 거래 문서 ----------
    function proposeOk(code) {
      let t = request.resource.data;
      let r = room(code);
      return canTrade(r)
        && t.status == 'pending' && t.by == request.auth.uid
        && t.from != t.to && exists(cp(code, t.to))
        && t.give.item in r.outputs[t.from] && t.get.item in r.outputs[t.from]
        && t.give.item != t.get.item
        && unitOk(r, t.give) && unitOk(r, t.get)
        && t.give.keys().hasOnly(['item', 'qty']) && t.get.keys().hasOnly(['item', 'qty'])
        && get(cp(code, t.from)).data.inv[t.give.item] >= t.give.qty
        && t.keys().hasOnly(['from', 'to', 'give', 'get', 'status', 'createdAt', 'by']);
    }
    function acceptOk(code, tid) {
      let o = resource.data;
      let n = request.resource.data;
      return o.status == 'pending' && n.status == 'done' && holds(code, o.to)
        && canTrade(room(code))
        && n.diff(o).affectedKeys().hasOnly(['status', 'doneAt'])
        && getAfter(cp(code, o.from)).data.op.tid == tid
        && getAfter(cp(code, o.to)).data.op.tid == tid;
    }
    function rejectOk(code) {
      let o = resource.data;
      let n = request.resource.data;
      // 받은 나라는 거절할 수 없고, 보낸 나라만 요청을 취소할 수 있음 (교사 무효 처리는 isTeacher)
      return o.status == 'pending'
        && n.diff(o).affectedKeys().hasOnly(['status'])
        && n.status == 'withdrawn' && holds(code, o.from);
    }

    match /rooms/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /countries/{cid} {
        allow read: if signedIn();
        allow create, delete: if isTeacher(code);
        allow update: if isTeacher(code)
          || validProduce(code, cid)
          || validUndo(code, cid)
          || validTradeSide(code, cid);
      }

      match /trades/{tid} {
        allow read: if signedIn();
        allow create: if signedIn() && (holds(code, request.resource.data.from) || isTeacher(code)) && proposeOk(code);
        allow update: if isTeacher(code) || acceptOk(code, tid) || rejectOk(code);
        allow delete: if isTeacher(code);
      }

      match /seats/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'lastSeen'])
          && exists(cp(code, cid))
          && !exists(mp(code, request.auth.uid))
          && getAfter(mp(code, request.auth.uid)).data.cid == cid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']);
        allow delete: if isTeacher(code);
      }

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || isTeacher(code));
        allow list: if isTeacher(code);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['cid'])
          && getAfter(sp(code, request.resource.data.cid)).data.uid == uid;
        allow delete: if isTeacher(code);
      }
    }
    // =====================================================
    // 무역 탐험대 훈련소 (연습 앱) — /practiceRooms/...
    // 단계: 1 입장, 2 생산 연습, 3 항해 연습, 4 거래 연습, 5 확인 퀴즈
    // =====================================================
    function prp(code) { return /databases/$(database)/documents/practiceRooms/$(code); }
    function pcp(code, cid) { return /databases/$(database)/documents/practiceRooms/$(code)/countries/$(cid); }
    function ptp(code, tid) { return /databases/$(database)/documents/practiceRooms/$(code)/trades/$(tid); }
    function psp(code, cid) { return /databases/$(database)/documents/practiceRooms/$(code)/seats/$(cid); }
    function pmp(code, uid) { return /databases/$(database)/documents/practiceRooms/$(code)/members/$(uid); }
    function proom(code) { return get(prp(code)).data; }
    function pTeacher(code) { return signedIn() && proom(code).ownerUid == request.auth.uid; }
    function pHolds(code, cid) { return signedIn() && exists(psp(code, cid)) && get(psp(code, cid)).data.uid == request.auth.uid; }
    function pCanProduce(r) { return r.stage == 2 && r.locks.production == false; }
    function pCanTrade(r) { return r.stage == 4 && r.locks.trade == false; }

    function pProduceOk(code, cid, item) {
      let r = proom(code);
      let o = resource.data;
      let n = request.resource.data;
      let amt = r.outputs[cid][item];
      let k = o.log.size();
      return pCanProduce(r)
        && o.chances > 0 && n.chances == o.chances - 1
        && n.inv.diff(o.inv).affectedKeys().hasOnly([item])
        && n.inv[item] == o.inv[item] + amt
        && n.log.size() == k + 1 && n.log[0:k] == o.log
        && n.log[k].item == item && n.log[k].amount == amt && n.log[k].round == 1
        && n.diff(o).affectedKeys().hasOnly(['inv', 'chances', 'log', 'op']);
    }
    function pUndoOk(code) {
      let r = proom(code);
      let o = resource.data;
      let n = request.resource.data;
      let k = o.log.size() - 1;
      let last = o.log[k];
      return r.allowUndo == true && pCanProduce(r)
        && n.log == o.log[0:k]
        && n.chances == o.chances + 1
        && n.undos == o.undos + 1
        && n.inv.diff(o.inv).affectedKeys().hasOnly([last.item])
        && n.inv[last.item] == o.inv[last.item] - last.amount
        && n.inv[last.item] >= 0
        && n.diff(o).affectedKeys().hasOnly(['inv', 'chances', 'log', 'undos', 'op']);
    }
    function pVisitOk(code) {
      let o = resource.data;
      let n = request.resource.data;
      let k = o.visits.size();
      return proom(code).stage == 3
        && k < 40 && n.visits.size() == k + 1 && n.visits[0:k] == o.visits
        && n.visits[k] == n.op.port && exists(pcp(code, n.op.port))
        && n.diff(o).affectedKeys().hasOnly(['visits', 'op']);
    }
    function pQuizOk(code) {
      let o = resource.data;
      let n = request.resource.data;
      let qid = n.op.q;
      return proom(code).stage == 5
        && qid in ['q1', 'q2', 'q3', 'q4'] && !(qid in o.quiz)
        && n.quiz.diff(o.quiz).affectedKeys().hasOnly([qid])
        && n.quiz[qid] is int && n.quiz[qid] >= 0 && n.quiz[qid] <= 2
        && n.diff(o).affectedKeys().hasOnly(['quiz', 'op']);
    }
    function pTradeSideOk(code, cid, tid) {
      let before = get(ptp(code, tid)).data;
      let after = getAfter(ptp(code, tid)).data;
      let o = resource.data;
      let n = request.resource.data;
      let gi = before.give.item;
      let gq = before.give.qty;
      let ti = before.get.item;
      let tq = before.get.qty;
      return pHolds(code, before.to) && pCanTrade(proom(code))
        && before.status == 'pending' && after.status == 'done'
        && (cid == before.from || cid == before.to)
        && n.inv.diff(o.inv).affectedKeys().hasOnly([gi, ti])
        && (cid == before.from
              ? (n.inv[gi] == o.inv[gi] - gq && n.inv[ti] == o.inv[ti] + tq)
              : (n.inv[gi] == o.inv[gi] + gq && n.inv[ti] == o.inv[ti] - tq))
        && n.inv[gi] >= 0 && n.inv[ti] >= 0
        && n.diff(o).affectedKeys().hasOnly(['inv', 'op']);
    }
    function pStudentCountryUpdate(code, cid) {
      let kind = request.resource.data.op.kind;
      return (kind == 'trade' && pTradeSideOk(code, cid, request.resource.data.op.tid))
        || (pHolds(code, cid) && (
              (kind == 'produce' && pProduceOk(code, cid, request.resource.data.op.item))
           || (kind == 'undo' && resource.data.log.size() > 0 && pUndoOk(code))
           || (kind == 'visit' && pVisitOk(code))
           || (kind == 'quiz' && pQuizOk(code))));
    }
    function pProposeOk(code) {
      let t = request.resource.data;
      let r = proom(code);
      return pCanTrade(r)
        && t.status == 'pending' && t.by == request.auth.uid
        && t.from != t.to && exists(pcp(code, t.to))
        && t.give.item in r.units && t.get.item in r.units
        && t.give.item != t.get.item
        && t.give.qty is int && t.give.qty == r.units[t.give.item]
        && t.get.qty is int && t.get.qty == r.units[t.get.item]
        && t.give.keys().hasOnly(['item', 'qty']) && t.get.keys().hasOnly(['item', 'qty'])
        && get(pcp(code, t.from)).data.inv[t.give.item] >= t.give.qty
        && t.keys().hasOnly(['from', 'to', 'give', 'get', 'status', 'createdAt', 'by']);
    }
    function pAcceptOk(code, tid) {
      let o = resource.data;
      let n = request.resource.data;
      return o.status == 'pending' && n.status == 'done' && pHolds(code, o.to)
        && pCanTrade(proom(code))
        && n.diff(o).affectedKeys().hasOnly(['status', 'doneAt'])
        && getAfter(pcp(code, o.from)).data.op.tid == tid
        && getAfter(pcp(code, o.to)).data.op.tid == tid;
    }
    function pWithdrawOk(code) {
      let o = resource.data;
      let n = request.resource.data;
      return o.status == 'pending'
        && n.diff(o).affectedKeys().hasOnly(['status'])
        && n.status == 'withdrawn' && pHolds(code, o.from);
    }

    match /practiceRooms/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /countries/{cid} {
        allow read: if signedIn();
        allow create, delete: if pTeacher(code);
        allow update: if pTeacher(code) || pStudentCountryUpdate(code, cid);
      }
      match /trades/{tid} {
        allow read: if signedIn();
        allow create: if signedIn() && (pHolds(code, request.resource.data.from) || pTeacher(code)) && pProposeOk(code);
        allow update: if pTeacher(code) || pAcceptOk(code, tid) || pWithdrawOk(code);
        allow delete: if pTeacher(code);
      }
      match /seats/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'joinedAt', 'lastSeen'])
          && exists(pcp(code, cid))
          && !exists(pmp(code, request.auth.uid))
          && getAfter(pmp(code, request.auth.uid)).data.cid == cid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']);
        allow delete: if pTeacher(code);
      }
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || pTeacher(code));
        allow list: if pTeacher(code);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['cid'])
          && getAfter(psp(code, request.resource.data.cid)).data.uid == uid;
        allow delete: if pTeacher(code);
      }
    }
  }
}
